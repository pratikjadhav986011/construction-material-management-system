    </title>

    <!-- BOOTSTRAP + FONTAWESOME -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

    <!-- PAGE-SPECIFIC HEAD CONTENT -->
    <asp:ContentPlaceHolder ID="HeadContent" runat="server"></asp:ContentPlaceHolder>

    <!-- YOUR GLOBAL CSS (same as in Home.aspx) -->
    <style>
        /* ====================================================================
           1. CSS VARIABLES & BASE STYLES
           ==================================================================== */
        :root {
            --primary-blue: #008cd7; 
            --banner-dark: #343a3c; 
            --banner-info-bg: #e9f6f3; 
            --banner-delivery-text: #04634f;
            --section-yellow: #ffc107; 
            --text-dark: #343a40;
            --font-family: 'Inter', sans-serif;
            --product-card-bg: white;
        }
        body {
            font-family: var(--font-family);
            background-color: #f4f4f4;
        }
       
                /* keep your full CSS here exactly as you pasted */
                 /* Reset ul/nav structure for correct semantics and styling */
        .secondary-links .nav .nav-item {
            padding: 0 0.5rem;
        }
        .secondary-links .nav {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        /* ====================================================================
           2. HEADER & NAVIGATION STYLING
           ==================================================================== */
        .top-header {
            background-color: var(--section-yellow); 
            color: var(--text-dark);
            padding: 5px 0;
            font-size: 0.9rem;
            font-weight: 500;
        }

            .main-nav {
        background-color: #ffffff !important;
        }


        .main-nav .logo-text {
            color: var(--text-dark);
            font-size: 1.8rem;
            font-weight: 700;
        }
        .site-logo {
            height: 85px;
            margin-top: -5px;
        }



        .main-nav .search-bar .input-group {
            height: 50px;
            margin: 0 auto; 
        }
        .main-nav .search-bar-wrapper {
            max-width: 600px;
            width: 100%;
        }
        /* OVERLAY */
        .sidebar-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,.45);
            opacity: 0;
            visibility: hidden;
            transition: .4s ease;
            z-index: 9998;
        }
        .sidebar-overlay.active {
            opacity: 1;
            visibility: visible;
        }

        /* SIDEBAR */
        .sidebar-menu {
            position: fixed;
            top: 0;
            left: -300px;
            width: 280px;
            height: 100%;
            background: #fff;
            transition: left .45s ease;
            box-shadow: 6px 0 25px rgba(0,0,0,.25);
            z-index: 9999;
        }
        .sidebar-menu.active {
            left: 0;
        }

        /* HEADER */
        .sidebar-header {
            padding: 16px;
            border-bottom: 1px solid #eee;
            font-weight: 600;
        }

        /* PROFILE */
        .sidebar-profile a {
            display: block;
            padding: 14px 18px;
            border-bottom: 1px solid #f1f1f1;
            text-decoration: none;
            color: #333;
        }
        .sidebar-profile i {
            margin-right: 10px;
        }

        /* LINKS */
        .sidebar-links {
            list-style: none;
            padding: 0;
            margin: 0;
        }
        .sidebar-links li {
            border-bottom: 1px solid #f1f1f1;
        }
        .sidebar-links a {
            display: block;
            padding: 14px 18px;
            color: #333;
            text-decoration: none;
            font-weight: 500;
        }
        .sidebar-links a i {
            width: 20px;
            margin-right: 10px;
        }
        .sidebar-links a:hover {
            background: #f8f9fa;
        }

        /* SUB MENU */
        .has-sub .sub-toggle {
            display: flex;
            justify-content: space-between;
            padding: 14px 18px;
            cursor: pointer;
            font-weight: 500;
        }
        .sub-menu {
            display: none;
            background: #fafafa;
        }
        .sub-menu a {
            padding-left: 45px;
            font-size: 0.95rem;
        }
        .has-sub.active .sub-menu {
            display: block;
        }
        .has-sub.active .fa-chevron-right {
            transform: rotate(90deg);
        }

        /* MENU ICON */
        .menu-icon {
            font-size: 22px;
            cursor: pointer;
        }


        .nav-icons-container {
            font-size: 1.1rem;
            justify-content: flex-end; 
        }
        .nav-icons-container .login-text {
            font-weight: 600;
            margin-left: 0.5rem;
            font-size: 1.1rem;
        }

        .main-nav .secondary-links .nav-link {
            padding: 0.5rem 1rem; 
            font-size: 1rem;
        }
       
         /* ================= COMPACT FOOTER ================= */

        .footer-links {
            background-color: #343a40;
            color: #f8f9fa;
            padding: 10px 0;   /* Reduced from 40px */
        }

        .footer-links h5 {
            font-size: 16px;
            margin-bottom: 12px;
        }

        .footer-links p,
        .footer-links a {
            font-size: 14px;
            margin-bottom: 3px;
            line-height: 1.5;
        }

        .footer-links a {
            display: block;
            color: #ffffff;
            text-decoration: none;
        }

        .footer-links a:hover {
            color: #ffc107;
        }

        /* Delivery Icons Section (reduce height) */
        .footer-links .border-top {
            margin-top: 10px !important;
            padding-top: 8px !important;
        }

        /* Bottom copyright bar */
        .footer-bottom {
            background-color: #212529;
            color: #adb5bd;
            padding: 4px 0;     /* Reduced height */
            font-size: 14px;
        }

    </style>
</head>

