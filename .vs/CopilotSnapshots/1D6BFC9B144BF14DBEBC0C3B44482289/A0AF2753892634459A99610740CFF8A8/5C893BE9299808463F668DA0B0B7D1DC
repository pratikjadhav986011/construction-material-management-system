        private DataTable GetPOsBySupplier(int supplierId)
        {
            con.Open();
            string q = @"SELECT PO.PO_ID, S.SupplierName, P.ProductName, PO.Quantity, PO.PurchasePrice, PO.TotalAmount, PO.PO_Date, PO.Status
                        FROM PurchaseOrders PO
                        JOIN Suppliers S ON PO.SupplierID = S.SupplierID
                        JOIN Products P ON PO.ProductID = P.ProductID
                        WHERE PO.SupplierID = @sid
                        ORDER BY PO.PO_ID DESC";
            MySqlDataAdapter da = new MySqlDataAdapter(q, con);
            da.SelectCommand.Parameters.AddWithValue("@sid", supplierId);
            DataTable dt = new DataTable();
            da.Fill(dt);
            con.Close();
            return dt;
        }

        private void GenerateSupplierPOReport(DataTable dt, string supplierName)
        {
            Response.ContentType = "application/pdf";
            Response.AddHeader("content-disposition", "attachment;filename=Supplier_PO_Report_" + supplierName + ".pdf");

            Document pdf = new Document(PageSize.A4.Rotate(), 20, 20, 20, 20);
            PdfWriter writer = PdfWriter.GetInstance(pdf, Response.OutputStream);
            writer.PageEvent = new PurchaseOrderFooter();
            pdf.Open();

            var titleFont = FontFactory.GetFont(FontFactory.HELVETICA_BOLD, 20);
            var headerFont = FontFactory.GetFont(FontFactory.HELVETICA_BOLD, 12);
            var normal = FontFactory.GetFont(FontFactory.HELVETICA, 11);

            // Header
            PdfPTable head = new PdfPTable(3) { WidthPercentage = 100 };
            head.SetWidths(new float[] { 20f, 50f, 30f });

            PdfPCell logoCell = new PdfPCell() { Border = Rectangle.NO_BORDER, Padding = 6 };
            try
            {
                string logoPath = Server.MapPath("~/images/logo.png");
                if (File.Exists(logoPath))
                {
                    iTextSharp.text.Image logo = iTextSharp.text.Image.GetInstance(logoPath);
                    logo.ScaleToFit(140f, 80f);
                    logo.Alignment = Element.ALIGN_LEFT;
                    logoCell.AddElement(logo);
                }
            }
            catch { }

            PdfPTable mid = new PdfPTable(1);
            mid.AddCell(new PdfPCell(new Phrase("Supplier Purchase Orders", titleFont)) { Border = Rectangle.NO_BORDER, PaddingBottom = 6, HorizontalAlignment = Element.ALIGN_LEFT });

            PdfPCell right = new PdfPCell(new Phrase("Supplier: " + supplierName + "\nGenerated: " + DateTime.Now.ToString("yyyy-MM-dd HH:mm"), normal)) { Border = Rectangle.NO_BORDER, HorizontalAlignment = Element.ALIGN_RIGHT };

            head.AddCell(logoCell);
            head.AddCell(new PdfPCell(mid) { Border = Rectangle.NO_BORDER, VerticalAlignment = Element.ALIGN_MIDDLE });
            head.AddCell(right);

            pdf.Add(head);
            pdf.Add(Chunk.NEWLINE);

            PdfPTable table = new PdfPTable(6) { WidthPercentage = 100, SpacingBefore = 6f };
            table.SetWidths(new float[] { 6f, 38f, 20f, 8f, 12f, 16f });

            BaseColor hdrBg = new BaseColor(230, 230, 250);

            PdfPCell MakeHeaderCell(string text)
            {
                var c = new PdfPCell(new Phrase(text, headerFont)) { BackgroundColor = hdrBg, HorizontalAlignment = Element.ALIGN_CENTER };
                c.Padding = 8f;
                c.MinimumHeight = 30f;
                return c;
            }

            table.AddCell(MakeHeaderCell("PO ID"));
            table.AddCell(MakeHeaderCell("Product"));
            table.AddCell(MakeHeaderCell("Supplier"));
            table.AddCell(MakeHeaderCell("Qty"));
            table.AddCell(MakeHeaderCell("Total (₹)"));
            table.AddCell(MakeHeaderCell("Date / Status"));

            bool alt = false;
            decimal grandTotal = 0;

            foreach (DataRow r in dt.Rows)
            {
                BaseColor rowBg = alt ? new BaseColor(250, 250, 255) : BaseColor.WHITE;

                PdfPCell MakeCell(string text, int align = Element.ALIGN_LEFT)
                {
                    var c = new PdfPCell(new Phrase(text, normal)) { BackgroundColor = rowBg, HorizontalAlignment = align };
                    c.Padding = 6f;
                    c.MinimumHeight = 26f;
                    return c;
                }

                table.AddCell(MakeCell(r["PO_ID"].ToString(), Element.ALIGN_CENTER));
                table.AddCell(MakeCell(r["ProductName"].ToString()));
                table.AddCell(MakeCell(r["SupplierName"].ToString()));
                table.AddCell(MakeCell(r["Quantity"].ToString(), Element.ALIGN_CENTER));

                decimal totalAmt = 0;
                Decimal.TryParse(Convert.ToString(r["TotalAmount"]), out totalAmt);
                table.AddCell(MakeCell(totalAmt.ToString("0.00"), Element.ALIGN_RIGHT));

                string dateStatus = "";
                if (r["PO_Date"] != DBNull.Value)
                    dateStatus += Convert.ToDateTime(r["PO_Date"]).ToString("yyyy-MM-dd HH:mm") + "\n";
                dateStatus += r["Status"].ToString();
                table.AddCell(MakeCell(dateStatus, Element.ALIGN_LEFT));

                grandTotal += totalAmt;
                alt = !alt;
            }

            pdf.Add(table);

            PdfPTable totals = new PdfPTable(2) { WidthPercentage = 40, HorizontalAlignment = Element.ALIGN_RIGHT };
            totals.SetWidths(new float[] { 60f, 40f });
            totals.AddCell(new PdfPCell(new Phrase("Grand Total", headerFont)) { Border = Rectangle.NO_BORDER, HorizontalAlignment = Element.ALIGN_RIGHT, Padding = 8f });
            totals.AddCell(new PdfPCell(new Phrase(grandTotal.ToString("0.00"), headerFont)) { Border = Rectangle.NO_BORDER, HorizontalAlignment = Element.ALIGN_RIGHT, Padding = 8f });

            pdf.Add(Chunk.NEWLINE);
            pdf.Add(totals);

            pdf.Close();
            Response.End();
        }
