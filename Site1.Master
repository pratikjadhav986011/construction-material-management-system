<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs"
    Inherits="ConstructionMaterialsManagement.Site" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>
        <asp:ContentPlaceHolder ID="head" runat="server" />
    </title>
            <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
            <link href="Styles/site.css" rel="stylesheet" />
    
    <style>
        /* ====================================================================
           1. CSS VARIABLES & BASE STYLES
           ==================================================================== */
        :root {
            --primary-blue: #008cd7; 
            --banner-dark: #343a3c; 
            --banner-info-bg: #e9f6f3; 
            --banner-delivery-text: #04634f;
            --section-yellow: #ffc107; 
            --text-dark: #343a40;
            --font-family: 'Inter', sans-serif;
            --product-card-bg: white;
        }

        body {
            font-family: var(--font-family);
            background-color: #f4f4f4;
        }
        
        /* Reset ul/nav structure for correct semantics and styling */
        .secondary-links .nav .nav-item {
            padding: 0 0.5rem;
        }
        .secondary-links .nav {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        /* ====================================================================
           2. HEADER & NAVIGATION STYLING
           ==================================================================== */
        .top-header {
            background-color: var(--section-yellow); 
            color: var(--text-dark);
            padding: 5px 0;
            font-size: 0.9rem;
            font-weight: 500;
        }
        
        .main-nav {
            background-color: white;
            border-bottom: 1px solid #ddd;
        }
        
        .main-nav .logo-text {
            color: var(--text-dark);
            font-size: 1.8rem;
            font-weight: 700;
        }

        .main-nav .search-bar .input-group {
            height: 50px;
            margin: 0 auto; 
        }
        .main-nav .search-bar-wrapper {
            max-width: 600px;
            width: 100%;
        }

        .nav-icons-container {
            font-size: 1.1rem;
            justify-content: flex-end; 
        }
        .nav-icons-container .login-text {
            font-weight: 600;
            margin-left: 0.5rem;
            font-size: 1.1rem;
        }
        .main-nav .secondary-links .nav-link {
            padding: 0.5rem 1rem; 
            font-size: 1rem;
        }
        
        /* ====================================================================
           3. NEW HERO BANNER SLIDESHOW STYLING
           ==================================================================== */

        .full-banner-slider {
            margin: 1.5rem 0; 
            overflow: hidden;
            position: relative;
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.2);
            border-radius: 0.5rem;
        }
        
        .full-banner-slider .carousel-item {
            height: 350px; /* Define a consistent height for the banner area */
            background-size: cover;
            background-position: center;
            position: relative;
        }

        /* Background Image Classes (REPLACE THESE PLACEHOLDER URLs with your actual image URLs) */
        .slide-image-1 { background-image: url('https://placehold.co/1200x350/343a3c/ffffff?text=YOUR+BANNER+IMAGE+1'); }
        .slide-image-2 { background-image: url('https://placehold.co/1200x350/555555/ffffff?text=YOUR+BANNER+IMAGE+2'); }
        .slide-image-3 { background-image: url('https://placehold.co/1200x350/777777/ffffff?text=YOUR+BANNER+IMAGE+3'); }

        /* Optional: Text overlay styles if you want text on the image */
        .banner-overlay-text {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            color: white;
            text-align: center;
            padding: 1rem 2rem;
            background: rgba(0, 0, 0, 0.4);
            border-radius: 0.5rem;
        }


        /* ====================================================================
           4. CATEGORIES & CARDS STYLING
           ==================================================================== */
        .categories-section, .products-listing {
            padding: 40px 0;
            background-color: var(--product-card-bg);
            border-bottom: 1px solid #ddd;
        }
        .category-item img {
            box-shadow: 0 4px 8px rgba(0,0,0,0.15);
        }
        .product-card {
            border: 1px solid #f0f0f0;
            border-radius: 0.5rem;
            transition: all 0.3s ease;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.05); 
            overflow: hidden;
            height: 100%;
        }
        .product-card:hover {
            box-shadow: 0 8px 15px rgba(0, 0, 0, 0.1) !important;
            transform: translateY(-5px); /* Lift effect */
        }
        .product-price {
            font-weight: 700;
            color: var(--text-dark);
        }
        
        /* ====================================================================
           5. MISC STYLING (Footer Callouts, Testimonials)
           ==================================================================== */
        .yellow-offer-section {
            background-color: var(--section-yellow);
            padding: 40px 0;
        }
        .yellow-offer-section h2 {
            font-weight: 900;
            color: var(--text-dark);
        }
        .footer-links {
            background-color: #343a40;
            color: #f8f9fa;
        }
        .footer-bottom {
            background-color: #212529;
            color: #adb5bd;
        }

    </style>
    
</head>

<body>
<form runat="server">

    <!-- ================= HEADER START ================= -->
    <asp:ContentPlaceHolder ID="HeaderContent" runat="server">

        <!-- 🔻 PASTE YOUR FULL HEADER + NAVIGATION HERE 🔻 -->

    </asp:ContentPlaceHolder>
    <!-- ================= HEADER END ================= -->


    <!-- ================= MAIN PAGE AREA ================= -->
    <asp:ContentPlaceHolder ID="MainContent" runat="server"></asp:ContentPlaceHolder>


    <!-- ================= FOOTER ================= -->
    <asp:ContentPlaceHolder ID="FooterContent" runat="server"></asp:ContentPlaceHolder>

</form>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
